# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit real credentials.

# Base URL for UI (browser) tests.
BASE_URL=https://example.com

# Base URL for API tests / API clients.
API_BASE_URL=https://api.example.com

# UI login credentials used by the `authenticatedPage` fixture.
TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=changeme

# API auth credentials used by api/helpers/auth.helper.ts.
API_AUTH_USERNAME=api-user
API_AUTH_PASSWORD=changeme

# Base URL for the SauceDemo feature slice (login + add-to-cart tests).
SAUCEDEMO_BASE_URL=https://www.saucedemo.com/
